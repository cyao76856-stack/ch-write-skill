{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "list.schema.json",
  "title": "CH-Write List Item",
  "type": "object",
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["structure", "stages", "genre", "deconstruction"]
    },
    "level": {
      "type": "string",
      "enum": ["simple", "standard", "full"]
    },
    "definition": { "type": "string" },
    "narrative_function": { "type": "string" },
    "layer": { "type": "string" },
    "mainline": { "type": "boolean" },
    "start_state": { "type": "string" },
    "cause": { "type": "string" },
    "conflict": { "type": ["string", "array", "object"] },
    "choice": { "type": ["string", "array", "object"] },
    "turn": { "type": "string" },
    "result": { "type": "string" },
    "setup_payoff": { "type": ["string", "array", "object"] },
    "information_change": { "type": "string" },
    "connections": { "type": "array", "items": { "type": "string" } },
    "object_type": { "type": "string" },
    "object_name": { "type": "string" },
    "stage_index": { "type": ["integer", "string"] },
    "initial_state": { "type": "string" },
    "trigger_event": { "type": "string" },
    "goal": { "type": "string" },
    "resistance": { "type": ["string", "array", "object"] },
    "state_change": { "type": ["string", "array", "object"] },
    "end_state": { "type": "string" },
    "irreversible_event": { "type": "string" },
    "next_stage": { "type": "string" },
    "main_genre": { "type": "string" },
    "subgenre": { "type": "string" },
    "blend": { "type": ["string", "array", "object"] },
    "novel_weight": { "type": ["string", "array", "object"] },
    "tone": { "type": "string" },
    "narrative_form": { "type": "string" },
    "world_nature": { "type": "string" },
    "target_medium": { "type": "string" },
    "target_audience": { "type": "string" },
    "genre_promise": { "type": "string" },
    "deviation": { "type": "string" },
    "genre_references": { "type": "array", "items": { "type": "string" } },
    "one_line_definition": { "type": "string" },
    "core_attributes": { "type": "object" },
    "current_state": { "type": "string" },
    "motivation": { "type": "string" },
    "function": { "type": "string" },
    "resources": { "type": ["string", "array", "object"] },
    "limitations": { "type": ["string", "array", "object"] },
    "relations": { "type": "array", "items": {} },
    "information": { "type": ["string", "array", "object"] },
    "key_actions": { "type": ["string", "array", "object"] },
    "change_stages": { "type": ["string", "array", "object"] },
    "causal_links": { "type": ["string", "array", "object"] },
    "consequences": { "type": ["string", "array", "object"] },
    "evidence": { "type": ["string", "array", "object"] },
    "symbolism": { "type": "string" },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "confirmed", "immutable", "tampered"]
    },
    "provenance": {
      "type": "string",
      "enum": ["source-derived", "inferred", "proposed", "imported", "unknown"]
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" },
      "uniqueItems": true
    },
    "related_items": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "impact": { "type": "array", "items": { "type": "string" } },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "history": { "type": "array", "items": {} },
    "revision": { "type": "string" }
  },
  "required": ["id", "name", "category", "level"],
  "additionalProperties": true
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object.schema.json",
  "title": "CH-Write Object",
  "type": "object",
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^(CHR|LOC|FCT|EVT|OBJ|RUL|REL|THM|SCN|STG|STR|DEC|CHG|SRC)-[0-9]{4,}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "character",
        "location",
        "faction",
        "event",
        "item",
        "rule",
        "theme",
        "scene",
        "stage",
        "structure"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "tombstoned",
        "merged"
      ]
    },
    "canon_membership": {
      "type": "string",
      "enum": [
        "active",
        "stale",
        "excluded"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "source-derived",
        "inferred",
        "proposed",
        "imported",
        "unknown"
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^rev-[0-9]{4,}$"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "object_id",
    "type",
    "name",
    "aliases",
    "attributes",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": true
}
